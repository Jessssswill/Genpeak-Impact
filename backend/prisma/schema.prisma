// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model MsUser {
  userId      String @id @map("UserID") @default(uuid())
  email       String @unique @map("Email")
  name        String @map("Name") @db.VarChar(50)
  password    String @map("Password") @db.VarChar(255)
  role        String

  createdAt DateTime @map("CreatedAt")
  createdBy String?  @map("CreatedBy") @db.VarChar(255)

  updatedAt DateTime @map("UpdatedAt")
  updatedBy String?  @map("UpdatedBy") @db.VarChar(255)

  trPurchases   TrPurchase[]
  trBattles     TrBattle[]
  trInventories TrInventory[]
  msWeapons     MsWeapon[]
  msArtifacts   MsArtifact[]
  trPlayerStats TrPlayerStats[]

  @@map("MsUser")
}

model TrPlayerStats {
  playerStatsId  Int     @id @default(autoincrement()) @map("PlayerStatsID")
  userId         String  @map("UserID") @db.VarChar(255)
  hp             Int     @map("HP")
  damage         Int     @map("Damage")
  criticalChance Decimal @map("CriticalChance")
  criticalDamage Decimal @map("CriticalDamage")
  money          Decimal @map("Money")

  createdAt DateTime @map("CreatedAt")
  createdBy String?  @map("CreatedBy") @db.VarChar(255)

  updatedAt DateTime @map("UpdatedAt")
  updatedBy String?  @map("UpdatedBy") @db.VarChar(255)

  user MsUser @relation(fields: [userId], references: [userId])

  @@map("TrPlayerStats")
}

model TrBattle {
  battleId Int     @id @default(autoincrement()) @map("BattleID")
  userId   String  @map("UserID") @db.VarChar(255)
  enemyId  Int     @map("EnemyID")
  money    Decimal @map("Money")

  createdAt DateTime @map("CreatedAt")
  createdBy String?  @map("CreatedBy") @db.VarChar(255)

  updatedAt DateTime @map("UpdatedAt")
  updatedBy String?  @map("UpdatedBy") @db.VarChar(255)

  user  MsUser  @relation(fields: [userId], references: [userId])
  enemy MsEnemy @relation(fields: [enemyId], references: [enemyId])

  @@map("TrBattle")
}

model TrInventory {
  inventoryId Int    @id @default(autoincrement()) @map("InventoryID")
  userId      String @map("UserID") @db.VarChar(255)
  itemId      Int    @map("ItemID")
  itemType    String @map("ItemType")
  
  level          Int      @default(0) @map("Level")
  reinforceLevel Int      @default(0) @map("ReinforceLevel")
  mainStatValue  Decimal? @map("MainStatValue")
  substats       Json?    @map("Substats")

  createdAt DateTime @map("CreatedAt")
  createdBy String?  @map("CreatedBy") @db.VarChar(255)

  updatedAt DateTime @map("UpdatedAt")
  updatedBy String?  @map("UpdatedBy") @db.VarChar(255)

  user MsUser @relation(fields: [userId], references: [userId])

  @@map("TrInventory")
}

model TrPurchase {
  purchaseId Int     @id @default(autoincrement()) @map("PurchaseID")
  userId     String  @map("UserID") @db.VarChar(255)
  itemId     Int     @map("ItemID")
  money      Decimal @map("Money")
  itemType   String  @map("ItemType")

  createdAt DateTime @map("CreatedAt")
  createdBy String?  @map("CreatedBy") @db.VarChar(255)

  updatedAt DateTime @map("UpdatedAt")
  updatedBy String?  @map("UpdatedBy") @db.VarChar(255)

  user MsUser @relation(fields: [userId], references: [userId])

  @@map("TrPurchase")
}

model MsEnemy {
  enemyId   Int    @id @default(autoincrement()) @map("EnemyID")
  elementId Int    @map("ElementID")
  name      String @map("Name") @db.VarChar(255)
  type      String @map("Type") @db.VarChar(30)
  imageUrl  String @map("ImageURL") @db.LongText
  hp        Int    @map("HP") @db.Int
  damage    Int    @map("Damage") @db.Int

  createdAt DateTime @map("CreatedAt")
  createdBy String?  @map("CreatedBy") @db.VarChar(255)

  updatedAt DateTime @map("UpdatedAt")
  updatedBy String?  @map("UpdatedBy") @db.VarChar(255)

  element   MsElement  @relation(fields: [elementId], references: [elementId])
  trBattles TrBattle[]

  @@map("MsEnemy")
}

model MsWeapon {
  weaponId    Int     @id @default(autoincrement()) @map("WeaponID")
  userId      String? @map("UserID") @db.VarChar(255)
  elementId   Int     @map("ElementID")
  name        String  @map("Name") @db.VarChar(50)
  type        String  @map("Type") @db.VarChar(30)
  description String  @map("Description") @db.VarChar(255)
  stock       Int     @map("Stock") @db.Int
  imageUrl    String  @map("ImageURL") @db.LongText
  price       Decimal @map("Price")
  damage      Int     @map("Damage") @db.Int

  createdAt DateTime @map("CreatedAt")
  createdBy String?  @map("CreatedBy") @db.VarChar(255)

  updatedAt DateTime @map("UpdatedAt")
  updatedBy String?  @map("UpdatedBy") @db.VarChar(255)

  user    MsUser?   @relation(fields: [userId], references: [userId])
  element MsElement @relation(fields: [elementId], references: [elementId])

  @@map("MsWeapon")
}

model MsArtifact {
  artifactId    Int     @id @default(autoincrement()) @map("ArtifactID")
  userId        String? @map("UserID") @db.VarChar(255)
  elementId     Int     @map("ElementID")
  name          String  @map("Name") @db.VarChar(100)
  setName       String  @map("SetName") @db.VarChar(50)
  type          String  @map("Type") @db.VarChar(30)
  description   String  @map("Description") @db.VarChar(255)
  stock         Int     @map("Stock") @db.Int
  imageUrl      String  @map("ImageURL") @db.LongText
  price         Decimal @map("Price")
  primaryStat   Decimal @map("PrimaryStat")
  secondaryStat Decimal @map("SecondaryStat")

  createdAt DateTime @map("CreatedAt")
  createdBy String?  @map("CreatedBy") @db.VarChar(255)

  updatedAt DateTime @map("UpdatedAt")
  updatedBy String?  @map("UpdatedBy") @db.VarChar(255)

  user    MsUser?   @relation(fields: [userId], references: [userId])
  element MsElement @relation(fields: [elementId], references: [elementId])

  @@map("MsArtifact")
}

model MsElement {
  elementId Int    @id @default(autoincrement()) @map("ElementID")
  name      String @map("Name") @db.VarChar(255)
  type      String @unique @map("Type") @db.VarChar(50)
  imageUrl  String @map("ImageURL") @db.LongText

  createdAt DateTime @map("CreatedAt")
  createdBy String?  @map("CreatedBy") @db.VarChar(255)

  updatedAt DateTime @map("UpdatedAt")
  updatedBy String?  @map("UpdatedBy") @db.VarChar(255)

  weapons   MsWeapon[]
  artifacts MsArtifact[]
  enemies   MsEnemy[]

  @@map("MsElement")
}
